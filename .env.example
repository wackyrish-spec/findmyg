# Copy to .env for local development, and add the same values in Cloudflare Pages > Settings > Variables.
SITE_URL=https://your-domain.example
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Set to 1 once Google sign-in is enabled in Supabase (Authentication > Providers > Google)
PUBLIC_GOOGLE_SIGNIN=
