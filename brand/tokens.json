      "signal-soft": { "value": "#2A2412" },
      "signal-text": { "value": "#FFD166", "note": "10.7:1 on signal-soft" },
      "pos":         { "value": "#3FBF82" },
      "pos-soft":    { "value": "#14291F" },
      "warn":        { "value": "#E0A54A" },
      "warn-soft":   { "value": "#2C2414" },
      "neg":         { "value": "#F07A66" },
      "star":        { "value": "#FFB400" },
      "wa":          { "value": "#25D366" },
      "wa-ink":      { "value": "#14171C" }
    }
