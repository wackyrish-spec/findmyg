  "font": {
    "f-display": { "value": "\"Barlow Condensed\", \"Arial Narrow\", system-ui, sans-serif", "note": "Headings, logo, all numbers. Weights 600/700/800. Uppercase headings tracked +0.02em. Use tabular figures." },
    "f-body":    { "value": "\"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "note": "Body. Weights 500/700/800" },
    "f-mono":    { "value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace", "note": "Chassis codes inside chips" },
    "f-arabic":  { "value": "\"IBM Plex Sans Arabic\", system-ui, sans-serif", "note": "Arabic V2, not loaded yet" }
  },
  "type-scale": {
    "$comment": "Mobile / desktop px. Display = Barlow Condensed 800 uppercase; body = Manrope.",
    "display-xl": "40 / 64",
    "display-l":  "32 / 44",
    "display-m":  "24 / 28",
    "display-s":  "18 / 20",
    "body":       "15 / 16, line-height 1.55",
    "small":      "13",
    "label":      "11, Manrope 800, uppercase, +0.09em"
  },
  "radius": { "chip": "0.16 x chip height (6px at 36px)", "button": "10px", "card": "14px", "icon-tile": "22% of tile" },
  "logo": {
    "min-width-px": 96,
    "clear-space": "Height of the MY chip on all sides",
    "files": "brand/logo/ (SVG, text outlined)",
    "rules": [
      "The amber chip is the only amber in the logo. Never recolour it blue.",
      "On amber backgrounds use the mono version (ink chip, white MY).",
      "No car silhouettes, spanners, pistons or chequered flags next to it.",
      "The chip may carry a chassis code (958, MK5, LC200) in campaigns; drop CAR when it does."
    ]
  }
}
