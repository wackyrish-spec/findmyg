---
import { communityLine, specFor, LEVELS, DATA_UPDATED, benchmarks, budgetTier, BENCH_SRC } from "../lib/data.js";
const fmt = (d) => (d ? new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "");
import Icon from "./Icon.astro";
const { g, make = null, model = null, plain = false, note = null } = Astro.props;
const claim = plain && make ? (g.self_claims || []).find((c) => c.make === make) : null;
const spec = make ? specFor(g, make, model) : null;
const level = spec ? spec.conf : 0;
const bench = (g.hasEvidence || g.ownerCount > 0) && !g.isDealer ? benchmarks(g, make, model).filter((b) => b.slug === "minor-service") : [];
const tier = bench.length ? budgetTier(g, make) : "";
// Dealer anchor in the "Main dealer for comparison" strip: same job (and model, when on a model page).
const dmin = g.isDealer && make ? benchmarks(g, make, model).find((b) => b.slug === "minor-service") : null;
const cline = !g.isDealer ? communityLine(g, model) : "";
const checked = fmt(g.google?.asOf || DATA_UPDATED);
const brandLines = g.specs.slice(0, 3);
// Compact spec payload for the browser to re-rank by the visitor's saved car.
const payload = JSON.stringify(g.specs.map((s) => [s.make, s.models, s.conf, s.cardEvidence]));
const maps = g.maps_url || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(g.name + " " + (g.area || "") + " Dubai")}`;
---
{plain ? (
<article class="plaincard" data-plain={g.slug}>
  <div><a href={`/garage/${g.slug}/`}><b>{g.name}</b></a>
    <div class="meta"><span><Icon name="pin" />{g.area || "Dubai"}</span>{g.isDealer ? <span class="dealer">Main dealer</span> : <span class="muted">Listed, no owner reviews yet</span>}</div>
    {dmin && <div class="benchline">Dealer minor service{dmin.car.replace(make, "").trim() ? `, ${dmin.car.replace(make, "").trim()}` : ""}: {dmin.from ? "from " : ""}<b>AED {Number(dmin.low).toLocaleString("en-US")}</b>{dmin.high > dmin.low ? ` to ${Number(dmin.high).toLocaleString("en-US")}` : ""} <span class="muted">· dealer price list</span></div>}
    {claim && <div class="claim">Says it works on {claim.make}{claim.url && <> (<a href={claim.url} target="_blank" rel="noopener nofollow">their website</a>)</>}</div>}</div>
  <div class="acts">
    {!g.isDealer && <a class="btn sm primary" href={`/review/${g.slug}/`}>Review</a>}
    {g.isDealer && g.phone && <a class="btn sm" href={`tel:${g.phone.replace(/\s/g, "")}`} data-track="call" data-slug={g.slug}>Call {g.phone}</a>}
    <a class="btn sm" href={`/garage/${g.slug}/`}>View</a>
  </div>
</article>
) : (
<article class="card gcard" data-garage={g.slug} data-specs={payload} data-ll={g.lat && g.lng ? `${Number(g.lat).toFixed(4)},${Number(g.lng).toFixed(4)}` : ""}>
  <div class="main">
    <div class="gtop"><h3><a href={`/garage/${g.slug}/`} data-track="view">{g.name}</a></h3></div>
    <div class="meta">
      <span><Icon name="pin" />{g.area || "Dubai"}</span>
      {g.worthDrive && <span class="wdrive">{g.emirate || "Outside Dubai"} · Worth the drive{g.driveMin ? `, about ${g.driveMin} min from Downtown` : ""}</span>}
      {g.founderPick && <a class="fpick" href="/how-it-works/#founders-picks">Founder's pick</a>}
      {g.goodFor.map((x) => <span class="goodfor">Good for: {x}</span>)}
      {g.isDealer ? <span class="dealer">Main dealer</span> : g.business_type && g.business_type !== "workshop" && <span class="biztag">Also sells parts</span>}
    </div>
    {note && <p class="pnote">{note}</p>}
    <div class="matchslot">
      {spec && (
        <><span class={`match l${level}`}>{LEVELS[level]}{model && !spec.modelHit ? ` (${make})` : ""}</span>{spec.mentions > 0 && <span class="mcount"> · from {spec.mentions} {/community/.test(spec.basis || "") && !/reviews/.test(spec.basis || "") ? (spec.mentions === 1 ? "community post" : "community posts") : (spec.mentions === 1 ? "review" : "reviews")}</span>}</>
      )}
    </div>
    {cline && <div class="cline"><a href={`/garage/${g.slug}/#community`}>{cline}</a></div>}
    {/* One plain line on the card; the full evidence lives on the garage page. */}
    <div class="evid">
      {g.cardSummary && (g.hasEvidence || g.ownerCount > 0) ? <span class="esum">{g.cardSummary}</span>
        : spec ? spec.cardEvidence || <span class="muted">No owner evidence for {make} yet</span>
        : brandLines.length ? brandLines.map((s, i) => (<>{i > 0 && <span class="sep">|</span>}{s.make}</>)) : <span class="muted">No specialty found yet</span>}
      {" "}<a class="seeev" href={`/garage/${g.slug}/#evidence`} data-track="view">See the evidence</a>
    </div>
  </div>
  <div class="stats">
    <div class="statrow">
      {g.own ? <div class="stat"><b>{g.own.avg.toFixed(1)}</b><small>Owners · {g.own.n}</small></div> : null}

    </div>
    {g.google && <p class="gfact">{Number(g.google.rating).toFixed(1)} on <a href={g.google.url || maps} target="_blank" rel="noopener nofollow">Google</a>, {(g.google.count || 0).toLocaleString("en-US")} reviews{checked ? `, checked ${checked}` : ""}</p>}
    {bench.length > 0 ? <p class="benchline">{tier && <span class="tier" title="Compared with other independents for this make">{tier}</span>}Minor service from <b>AED {Number(bench[0].low).toLocaleString("en-US")}</b>{bench[0].car.replace(make || "", "").trim() ? ` (${bench[0].car.replace(make || "", "").trim()})` : ""} <span class="muted">· {BENCH_SRC[bench[0].src]}</span></p>
      : g.priceTalk?.label && !g.isDealer && <p class={`ptalk ${g.priceTalk.tone}`}>{g.priceTalk.label}</p>}
    <div class="acts">
      {g.waNumber && <button class="btn wa sm" type="button" data-wa={g.slug} data-wa-num={g.waNumber} data-name={g.name} title={g.waConfirmed ? undefined : "WhatsApp (number from the garage's listing)"}><Icon name="wa" />{g.waConfirmed ? "WhatsApp" : "Try WhatsApp"}</button>}
      {g.phone && <a class={`btn sm${g.waNumber ? "" : " primary"}`} href={`tel:${g.phone.replace(/\s/g, "")}`} data-track="call">Call</a>}
      <a class="btn sm" href={maps} target="_blank" rel="noopener" data-track="directions">Directions</a>
      <a class={`btn sm${g.waNumber || g.phone ? "" : " primary"}`} href={`/garage/${g.slug}/`} data-track="view">View</a>
    </div>
  </div>
</article>
)}
