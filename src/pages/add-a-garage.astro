---
import Base from "../layouts/Base.astro";
---
<Base title="Add a garage or suggest a correction" description="Know a great specialist in Dubai that's missing from GarageGuide? Tell us." noindex={true} crumbs={[{ name: "Add a garage" }]}>
  <div class="wrap" style="padding-block:20px 56px;max-width:680px">
    <h1 style="font-size:42px;text-transform:uppercase">Add a garage</h1>
    <p class="muted">Tell us about a specialist that's missing, or a correction to a listing. This form goes live together with owner reviews, very soon.</p>
  </div>
</Base>
