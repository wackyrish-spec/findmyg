---
// "Not yet" answer: honest, one next step (notify). No all-makes or family lists (Rishal 10 Nov: keep it specialised). noindex.
import Base from "../layouts/Base.astro";
---
<Base title="Your car isn't covered yet" description="We don't cover your car yet. Tell us you want it and it moves up our list." noindex={true} crumbs={[{ name: "Your car" }]}>
  <div class="wrap" id="ncPage" style="padding-block:20px 56px;max-width:720px">
    <h1 id="ncTitle" style="font-size:40px;text-transform:uppercase">We don't cover your car yet</h1>
    <p class="muted" id="ncLead">We only list garages that owners vouch for with your car. Tell us you want it, and it moves up our list.</p>
    <div class="card panel wantbox" id="ncWant" hidden></div>
    <details class="card panel ncpick" id="ncPick">
      <summary id="ncPickSum">Not quite your car?</summary>
      <div class="ncpickrow">
        <label class="fld" for="ncMake">Make<select id="ncMake"></select></label>
        <label class="fld" for="ncModel">Model<select id="ncModel" disabled></select></label>
        <label class="fld" for="ncYear">Year (optional)<input id="ncYear" inputmode="numeric" maxlength="4" placeholder="e.g. 2019" /></label>
      </div>
    </details>
    <p class="muted" id="ncSuggest" hidden>Know a great <span id="ncSuggestMake"></span> specialist? <a href="/add-a-garage/">Suggest a garage</a>.</p>
  </div>
</Base>
