---
// Known issues by model (PM spec 14): /dubai/{make}/{model}/issues/. Content is markdown in src/content/issues/,
// written by Research and the founder. Frontmatter: make, model, title, description, updated, status (draft | published).
// Drafts build but stay noindex; nothing is generated for models without a file.
import Base from "../../../../../layouts/Base.astro";
import { BRANDS, slugify } from "../../../../../lib/data.js";
export function getStaticPaths() {
  const files = Object.values(import.meta.glob("../../../../../content/issues/*.md", { eager: true }));
  return files.flatMap((f) => {
    const fm = f.frontmatter || {};
    const b = BRANDS.find((x) => x.make === fm.make);
    if (!b) return [];
    // A model with no specialists page yet still gets its issues page; the button then goes to the brand page.
    const m = b.models.find((x) => x.model === fm.model || x.slug === slugify(fm.model)) || { model: fm.model, slug: slugify(fm.model), none: true };
    return [{ params: { make: b.slug, model: m.slug }, props: { f, b, m } }];
  });
}
const { f, b, m } = Astro.props;
const fm = f.frontmatter;
const Content = f.Content;
// PM rule: indexed only when published with 3+ sourced issues (frontmatter sourced_issues, set by Research).
const published = fm.status === "published" && Number(fm.sourced_issues || 0) >= 3;
---
<Base title={fm.title || `${b.make} ${m.model} known issues: what fails and who fixes it in Dubai`} description={fm.description || `Common ${b.make} ${m.model} problems, what they cost at the dealer and at independents in Dubai, and which garages owners trust with them.`} noindex={!published}
  crumbs={[{ name: "Dubai", url: "/dubai/" }, { name: b.make, url: `/dubai/${b.slug}/` }, ...(m.none ? [] : [{ name: m.model, url: `/dubai/${b.slug}/${m.slug}/` }]), { name: `${m.model} known issues` }]}>
  <article class="wrap prose issues" style="padding-block:20px 56px;max-width:760px">
    <h1>{fm.h1 || `${b.make} ${m.model} known issues`}</h1>
    {fm.updated && <p class="muted">Updated {fm.updated}{fm.author ? ` · ${fm.author}` : ""}</p>}
    <Content />
    <p><a class="btn primary" href={m.none ? `/dubai/${b.slug}/` : `/dubai/${b.slug}/${m.slug}/`}>See {m.none ? b.make : `${b.make} ${m.model}`} specialists</a></p>
  </article>
</Base>
