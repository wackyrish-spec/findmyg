---
import ListPage from "../../../../components/ListPage.astro";
import { AREAS, intro, isIndexable, splitGeneral } from "../../../../lib/data.js";
export function getStaticPaths() {
  return AREAS.map((a) => ({ params: { area: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const key = `dubai/area/${a.slug}`;
const L = splitGeneral(a.garages);
const it = intro(key);
---
<ListPage
  title={it?.title || `Car garages in ${a.name}, Dubai`}
  description={it?.description || `Independent garages in ${a.name}, Dubai, with the car brands each one specialises in.`}
  h1={it?.h1 || `Garages in ${a.name}`}
  lead={`Independent garages in ${a.name}, with the ones owners back in reviews first.`}
  introText={it?.text}
  garages={L.ranked}
  others={L.others}
  outside={L.outside}
  othersLabel={`Also in ${a.name}, no reviews yet`}
  noindex={!isIndexable(key, a.evidenceCount)}
  crumbs={[{ name: "Dubai", url: "/dubai/" }, { name: a.name }]}
  related={AREAS.filter((x) => x.slug !== a.slug).map((x) => ({ name: `Garages in ${x.name}`, url: `/dubai/area/${x.slug}/` }))}
/>
