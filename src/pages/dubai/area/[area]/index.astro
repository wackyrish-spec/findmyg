---
import ListPage from "../../../../components/ListPage.astro";
import { AREAS, intro, isIndexable } from "../../../../lib/data.js";
export function getStaticPaths() {
  return AREAS.map((a) => ({ params: { area: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const key = `dubai/area/${a.slug}`;
---
<ListPage
  title={`Car garages in ${a.name}, Dubai`}
  description={`${a.garages.length} independent garages in ${a.name}, Dubai, with the car brands each one specialises in.`}
  h1={`Garages in ${a.name}`}
  lead={`${a.garages.length} independent garages in ${a.name}. Set your car to see which ones know it best.`}
  introText={intro(key)?.text}
  garages={a.garages}
  noindex={!isIndexable(key, a.evidenceCount)}
  crumbs={[{ name: "Dubai", url: "/dubai/" }, { name: a.name }]}
  related={AREAS.filter((x) => x.slug !== a.slug).map((x) => ({ name: `Garages in ${x.name}`, url: `/dubai/area/${x.slug}/` }))}
/>
