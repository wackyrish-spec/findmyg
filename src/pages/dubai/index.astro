---
import ListPage from "../../components/ListPage.astro";
import { GARAGES, BRANDS, AREAS, JOB_PAGES, splitGeneral } from "../../lib/data.js";
const related = [
  ...BRANDS.slice(0, 12).map((b) => ({ name: `${b.make} specialists`, url: `/dubai/${b.slug}/` })),
  ...AREAS.map((a) => ({ name: `Garages in ${a.name}`, url: `/dubai/area/${a.slug}/` })),
  ...JOB_PAGES.map((j) => ({ name: j.name, url: `/dubai/job/${j.slug}/` })),
];
const L = splitGeneral(GARAGES);
---
<ListPage
  title="Independent car garages in Dubai"
  description={`Independent garages in Dubai, with the car brands and models each one knows best.`}
  h1="Independent garages in Dubai"
  lead="Set your car and this list re-sorts by how well each garage knows it. Garages with evidence from real reviews come first."
  garages={L.ranked}
  others={L.others}
  outside={L.outside}
  othersLabel={"Also in Dubai, no reviews yet"}
  noindex={false}
  crumbs={[{ name: "Dubai" }]}
  related={related}
/>
